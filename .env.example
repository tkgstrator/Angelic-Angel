# Placeholder: replace with your real webhook URL in .env (never commit .env).
# From a container, use host.docker.internal instead of localhost for a host webhook.
WEBHOOK_ENDPOINT=https://your-webhook.example.com/endpoint
# Webhook 署名用の共有シークレット(Webhook URL を設定する場合は必須)。受信側と同じ値を設定し、決してコミットしないこと。
WEBHOOK_SECRET_KEY=replace-with-your-shared-secret
# X の認証情報(ブラウザの Cookie `auth_token` と `ct0` の値)。両方を設定すると、初回の `listen` が
# 自動で登録する。片方だけはエラー。値は設定ファイルに書き込まれない。決してコミットしないこと。
TWITTER_AUTH_TOKEN=replace-with-your-auth_token-cookie
TWITTER_CSRF_TOKEN=replace-with-your-ct0-cookie
